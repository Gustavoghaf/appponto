PORT=3000
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# ---- Banco de dados (opcional) ----
# Se não definir, o app usa um arquivo local em data/db.json automaticamente.
# Para usar Postgres/Supabase, cole aqui a "Connection string" do projeto:
# DATABASE_URL=postgresql://postgres:SUASENHA@db.xxxxxxx.supabase.co:5432/postgres

# ---- Google Drive (opcional) ----
# Se não definir, as fotos ficam salvas localmente em /uploads.
# Veja o README (seção "Google Drive") para o passo a passo completo.
# GOOGLE_DRIVE_FOLDER_ID=id-da-pasta-do-drive
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=xxxxxxx   <- gerado por `node setup-google-drive.js`
